00c0C\u00adi\u00deq*,\u00c0\u000e-\u00b2\u009d\u00ef\u00a7\u00b6?;p\u00ce\u0088\u00d2\u009e8\u00c0\u008b\u00fde\u00f7\u00e4\u0001-\u00c0\u00ed\u009e&lt;,\u00d4Z\u0011@\u0019\u00e2X\u0017\u00b7\u00118\u00c08\u00f8\u00c2d\u00aa\u00c0*\u00c0M\u0084\rO\u00af\u0094\u0014@V\u009f\u00ab\u00ad\u00d8\u00bf8\u00c0\u008a\u008e\u00e4\u00f2\u001fr+\u00c0)\u00ed\r\u00be0\u0099\u001a@]m\u00c5\u00fe\u00b2\u00cb8\u00c0N\u00d1\u0091\\\u00fe\u00a3)\u00c0\u00ce\u0019Q\u00da\u001b\u00bc\"@\u008f\u00c2\u00f5(\\\u00ff8\u00c0\u008a\u001fc\u00eeZ\u0082-\u00c0:\u0092\u00cb\u007fH\u00ff\u0012@\u0003\t\u008a\u001fc\u00ae6\u00c0\u00d7\u0012\u00f2A\u00cf\u0086+\u00c0a2U0*\u00a9\u0014@p_\u0007\u00ce\u0019\u00e15\u00c0\u00b3{\u00f2\u00b0P\u00ab,\u00c0yX\u00a85\u00cd{\u0015@,\u00d4\u009a\u00e6\u001d\u00b74\u00c0\u00ce\u00aa\u00cf\u00d5Vl/\u00c0C\u00adi\u00deqJ\u0014@\u000f\u000b\u00b5\u00a6y\u00b74\u00c0\u00baI\f\u0002+\u00e7/\u00c0\u00d9=yX\u00a8\u00b5\u0012@\u00a2E\u00b6\u00f3\u00fd\u00046\u00c0\u00b9\u008d\u0006\u00f0\u0016\u00a80\u00c0\u00d5\th\"lx\u0014@\u0086\u00c9T\u00c1\u00a8\u00b43\u00c0\u00b2\u009d\u00ef\u00a7\u00c6k0\u00c0$(~\u008c\u00b9\u00ab\u0015@\u0080H\u00bf}\u001dh2\u00c0\u0089A`\u00e5\u00d0\u00a2.\u00c0\u00b57\u00f8\u00c2d\u00ea\u0016@\u0087\u0016\u00d9\u00ce\u00f7\u00f31\u00c0\u00db\u008a\u00fde\u00f7\u00941\u00c0\u0010z6\u00ab&gt;W\u0015@\f\u0093\u00a9\u0082Q\u00891\u00c0Dio\u00f0\u0085\u00991\u00c0\u00e0\u009c\u0011\u00a5\u00bd\u0001\u0017@Y\u0017\u00b7\u00d1\u0000.0\u00c0\nh\"lx\u00da2\u00c0\u00c5 \u00b0rh\u0091\u0015@]\u00dcF\u0003xk/\u00c05^\u00baI\f\u00823\u00c0jM\u00f3\u008eSt\u0013@\u00d5\u00e7j+\u00f6\u00c70\u00c0\u001d\u00c9\u00e5?\u00a4\u00bf2\u00c0&amp;S\u0005\u00a3\u0092:\u0013@\u00aa\u00f1\u00d2Mb\u00e01\u00c0\u0086\u00c9T\u00c1\u00a8d3\u00c0\u0004\u00e7\u008c(\u00edM\u0016@B&gt;\u00e8\u00d9\u00ac\u009a,\u00c00\u00bb'\u000f\u000b52\u00c0r\u00f9\u000f\u00e9\u00b7/\u0017@9\u00b4\u00c8v\u00be\u009f*\u00c0I.\u00ff!\u00fd61\u00c0\u00f5JY\u00868V\u001b@\u00d5\th\"l\u00d8+\u00c0\u00c5\u00fe\u00b2{\u00f2\u00900\u00c0\u00f0\u0085\u00c9T\u00c1\u00a8\u0019@_\u0098L\u0015\u008c\u008a.\u00c0\u009f\u00cd\u00aa\u00cf\u00d5\u00c62\u00c0o\u00f0\u0085\u00c9T\u0081\u0019@\u001c\u00eb\u00e26\u001a\u0000(\u00c0\u00d1\"\u00db\u00f9~z1\u00c02U0*\u00a9\u00d3\u0011@'1\b\u00ac\u001c\u001a*\u00c0)\u00ed\r\u00be0\u00d9)\u00c0o\u00f0\u0085\u00c9T\u00c1\u00b8?\u00ff!\u00fd\u00f6u\u00d06\u00c0KY\u00868\u00d6E*\u00c0\u00f8S\u00e3\u00a5\u009bD\u0004@\u00ecQ\u00b8\u001e\u0085{6\u00c0\u00cc]K\u00c8\u0007\u001d/\u00c0\u00b5\u00a6y\u00c7):\u0006@@\u0013a\u00c3\u00d3\u000b:\u00c0\u00ea\u00044\u00116|.\u00c0g\u00d5\u00e7j+\u00f6\u00d7?\u009c3\u00a2\u00b47h:\u00c0\u00e3\u00a5\u009b\u00c4 \u00f0+\u00c0\u008d(\u00ed\r\u00be0\u00ef\u00bf\u0012\u00a5\u00bd\u00c1\u0017\u00c68\u00c0\u00e6?\u00a4\u00df\u00be\u00ce.\u00c0\u00f9\u00a0g\u00b3\u00eas\u0012@\t\u00f9\u00a0g\u00b3\u009a8\u00c0R\u00b8\u001e\u0085\u00ebq*\u00c0*\u00a9\u0013\u00d0D\u0018\u0013@2\u00e6\u00ae%\u00e4\u00c39\u00c0\u00d0\u00d5V\u00ec/\u00db(\u00c04\u0080\u00b7@\u0082\u00e2\u0013@]m\u00c5\u00fe\u00b2;8\u00c0\u00ce\u0088\u00d2\u00de\u00e0\u00cb+\u00c0$\u0097\u00ff\u0090~;\u001c@=,\u00d4\u009a\u00e6\u00cd7\u00c0\u00e3\u00a5\u009b\u00c4 0-\u00c0\u00f5\u00b9\u00da\u008a\u00fde\u001b@`\u00e5\u00d0\"\u00dbi9\u00c0vq\u001b\r\u00e0\r(\u00c0\u00cc\u00ee\u00c9\u00c3B\r$@.\u0090\u00a0\u00f81V9\u00c0\f\u0093\u00a9\u0082Q\u0089+\u00c0\u00a4\u00df\u00be\u000e\u009c3#@\u00f1\u00f4JY\u0086x9\u00c0\u00d4\u009a\u00e6\u001d\u00a7\u00c8)\u00c0\u00b5\u00a6y\u00c7)\u00ba\"@\u00eeZB&gt;\u00e8\u00e97\u00c09\u00d6\u00c5m4\u0080+\u00c0_\u0007\u00ce\u0019Q\u00da\u0016@9\u00b4\u00c8v\u00be\u00df3\u00c0f\u0088c]\u00dc\u00d60\u00c0p_\u0007\u00ce\u0019Q\u0011@-!\u001f\u00f4l\u00866\u00c0B\u00cff\u00d5\u00e7\u009a1\u00c0\u00ac\u00ad\u00d8_v\u008f\u0013@c\u007f\u00d9=y\u00f83\u00c0\u00dc\u00d7\u0081sFt4\u00c0t$\u0097\u00ff\u0090\u00fe\u0011@\u001aQ\u00da\u001b|\u00c10\u00c0\u00ac\u001cZd;\u00ff3\u00c0\u009f&lt;,\u00d4\u009a\u00e6\u0012@\u0091\u00ed|?5\u00fe+\u00c0\u0002\u009a\b\u001b\u009e\u000e4\u00c0\u008a\u001fc\u00eeZ\u00c2\u0019@4\u00116&lt;\u00bd\u0092,\u00c0@\u00a4\u00df\u00be\u000el0\u00c09\u00d6\u00c5m4@\u001c@\u00b4Y\u00f5\u00b9\u00daj*\u00c0\u00e9\u00b7\u00af\u0003\u00e7\u00bc1\u00c0tF\u0094\u00f6\u0006\u001f\u001f@KY\u00868\u00d6%,\u00c0\u00e6?\u00a4\u00df\u00be\u001e0\u00c0\u0084\rO\u00af\u0094%\u001d@\u0001\u00de\u0002\t\u008a\u007f/\u00c0&amp;S\u0005\u00a3\u0092z/\u00c0;\u00dfO\u008d\u0097\u00ee\u0016@]\u00dcF\u0003x+.\u00c0\u0094\u0087\u0085Z\u00d3\u00fc1\u00c0\u0083\u00c0\u00ca\u00a1Ev\u001a@\u00deq\u008a\u008e\u00e4\u0092&amp;\u00c0E\u00d8\u00f0\u00f4JY3\u00c0k\u009aw\u009c\u00a2#\u001d@h\u00b3\u00eas\u00b5U(\u00c0\u00a6\u009b\u00c4 \u00b0r3\u00c0\u00ac\u008b\u00dbh\u0000\u00af\u0016@\u009c\u00a2#\u00b9\u00fc\u0007'\u00c0\u00c19#J{\u00a30\u00c0Y\u0017\u00b7\u00d1\u0000^\u0012@\u00e9H.\u00ff!\u00bd(\u00c0\u0085\u00ebQ\u00b8\u001e%2\u00c0\u008d\u0097n\u0012\u0083\u00c0\r@\u0013\u00f2A\u00cff5)\u00c0\u00bct\u0093\u0018\u0004\u00161\u00c0\u008e\u0006\u00f0\u0016H\u0010\u0010@vO\u001e\u0016j\u00ed+\u00c0r\u00f9\u000f\u00e9\u00b7\u00af(\u00c0H\u00bf}\u001d8\u00a7\u001e@j\u00deq\u008a\u008e\u00849\u00c0\u00c0\u00ec\u009e&lt;,4&amp;\u00c0\u00a0\u0089\u00b0\u00e1\u00e9U\u001d@\u00a5N@\u0013a\u00d38\u00c0\u00f4\u00fd\u00d4x\u00e9\u00e6(\u00c0\u0010\u00e9\u00b7\u00af\u0003g\u001e@(~\u008c\u00b9k\u00f9:\u00c0", {}], "molprops": {"atom.dprop.PartialCharge": "-0.13151637704918034 -0.10701637704918035 -0.12131637704918036 -0.10701637704918035 -0.13151637704918034 -0.11801637704918035 0.13528362295081967 -0.050416377049180353 -0.32561637704918034\n-0.36931637704918036 0.088383622950819654 -0.51181637704918037 0.30318362295081969 -0.11171637704918035 -0.20131637704918035 -0.43211637704918032 0.61158362295081969 -0.5961163770491803\n0.25478362295081969 -0.17261637704918034 -0.11961637704918035 0.011383622950819652 -0.50781637704918037 -0.0031163770491803491 -0.046016377049180351 -0.0704163770491803